[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; The post stack for Space Stranding, in one material.
;
; These are the values the four-ColorRect chain was running before it was merged
; into film.gdshader: each effect's own shader defaults, plus the one value Mac
; changed (grain_saturation). The merge was verified to render the same frame,
; not just to compile - tests/probe_post_cost.tscn measures a mean per-channel
; difference of 0.13/255 against a no-post control of 2.47/255.
;
; This file previously carried StarChef's tuning, which is a different look.
; Those values are in git history at 253e9f4 if they are ever wanted back.

[ext_resource type="Shader" uid="uid://cicfdg8iufkc5" path="res://shaders/post/film.gdshader" id="1_film"]

[resource]
resource_name = "Film (post stack)"
shader = ExtResource("1_film")
shader_parameter/ca_amount = 0.00054
shader_parameter/lens_softness = 0.544
shader_parameter/edge_falloff = 0.836
shader_parameter/glow_threshold = 0.539
shader_parameter/glow_knee = 0.262
shader_parameter/glow_radius = 4.566
shader_parameter/glow_intensity = 1.216
shader_parameter/glow_tint = Color(0.816985, 0.930485, 0.945713, 1.0)
shader_parameter/halation_threshold = 0.7
shader_parameter/halation_knee = 0.2
shader_parameter/halation_radius = 5.0
shader_parameter/channel_spread = 1.2
shader_parameter/halation_intensity = 0.6
shader_parameter/halation_tint = Color(1, 0.32, 0.12, 1)
shader_parameter/grain_intensity = 0.116
shader_parameter/grain_saturation = 0.562
shader_parameter/min_lum = 0.019
shader_parameter/max_lum = 0.487
shader_parameter/time_scale = 0.079
