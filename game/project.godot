; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Space Stranding"
config/description="A hauler on a tidally locked exoplanet."
run/main_scene="res://scenes/world/test_world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

World="*res://scripts/core/world_constants.gd"
Lattice="*res://scripts/world/lattice.gd"
Orders="*res://scripts/orders/order_book.gd"
Debug="*res://scripts/ui/debug_panel.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/spawn_gizmos/plugin.cfg")

[gui]

theme/custom_font="uid://vevnpe02133f"

